NODE_ENV=development
PORT=3000

# Supabase: Project Settings > Database > Connection string (URI). Use the
# session pooler (port 5432) or the direct connection. Create the schema with
# `npm run migrate`.
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Separate throwaway database used only by `npm test` (never the Supabase one)
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:55432/khanak_test

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Public address of this API (defaults to the address the request came in on)
PUBLIC_BASE_URL=https://api.example.com

# Where a worker's own link opens. Until the web page exists, leave it empty
# and links open the API's JSON at /v1/public/workers/<token>.
WORKER_LINK_BASE_URL=

# Email for password reset codes. Without SMTP_HOST nothing is sent; in
# development the email is printed to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Khanak <no-reply@example.com>"

# Comma-separated browser origins allowed to send credentials (optional)
CORS_ORIGINS=

# Oldest app build (the number after "+" in the app version) that may still
# be used. Empty or 0 lets every build through.
MIN_APP_BUILD_ANDROID=
APP_STORE_URL_ANDROID=
# "true" shows the maintenance screen in the app and refuses every API call
# except the version check.
MAINTENANCE_MODE=

LOG_LEVEL=
